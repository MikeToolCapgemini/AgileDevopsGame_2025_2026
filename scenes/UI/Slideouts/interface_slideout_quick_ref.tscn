bbcode_enabled = true
text = "[font_size=18][b]Interrupt Alarm:[/b][/font_size]

Put the hourglass in a visible place (interrupt alarm).

Turn the hourglass over once the game has started.

Facilitator / participants monitor the hourglass once
the game has started."

[node name="RichTextLabelStartgame" type="RichTextLabel" parent="Panel/Container/GridContainer"]
custom_minimum_size = Vector2(333, 300)
layout_mode = 2
