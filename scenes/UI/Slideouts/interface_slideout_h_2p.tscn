[node name="RichTextLabel2" type="RichTextLabel" parent="Panel/Container/LeftSide/PlayMaterial"]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2
theme_override_colors/default_color = Color(1, 1, 1, 1)
theme_override_fonts/normal_font = ExtResource("2_7orem")
theme_override_fonts/bold_font = ExtResource("3_p8iyf")
theme_override_font_sizes/normal_font_size = 14
bbcode_enabled = true
text = " - Rules
 - Game board
 - 16 pawns in 8 colors, 2 per color
 - Dice
 - 26 Action cards
 - 171 question cards (cards with a lock)
 - 171 Answer cards (cards with a key)
 - List of answers and some notes for the facilitator
 - hourglass"
fit_content = true

