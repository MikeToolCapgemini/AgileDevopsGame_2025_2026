[node name="RichTextLabel" type="RichTextLabel" parent="Panel/Container/RightSide/PreperationText"]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2
theme_override_colors/default_color = Color(1, 1, 1, 1)
theme_override_fonts/normal_font = ExtResource("2_7orem")
theme_override_fonts/bold_font = ExtResource("3_p8iyf")
theme_override_font_sizes/normal_font_size = 14
text = " - Place the game board on the table"
fit_content = true

[node name="RichTextLabel2" type="RichTextLabel" parent="Panel/Container/RightSide/PreperationText"]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2
theme_override_colors/default_color = Color(1, 1, 1, 1)
theme_override_fonts/normal_font = ExtResource("2_7orem")
theme_override_fonts/bold_font = ExtResource("3_p8iyf")
theme_override_font_sizes/normal_font_size = 14
text = " - Sort the question cards (cards with a lock. make a pile) per color and put them in number order. Insert 3 to 4 action cards randomly into each pile. Place the piles lengthwise on the game board in order of the phaseson the game board. )"
fit_content = true

[node name="RichTextLabel3" type="RichTextLabel" parent="Panel/Container/RightSide/PreperationText"]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2
theme_override_colors/default_color = Color(1, 1, 1, 1)
theme_override_fonts/normal_font = ExtResource("2_7orem")
theme_override_fonts/bold_font = ExtResource("3_p8iyf")
theme_override_font_sizes/normal_font_size = 14
text = "- There is a division between Basic Cards and Professional Cards. the question cards for the more experienced players can be used if more experienced players are participating, but you can also leave them out. They can be identified by the plus sign on the card."
fit_content = true

[node name="RichTextLabel4" type="RichTextLabel" parent="Panel/Container/RightSide/PreperationText"]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2
theme_override_colors/default_color = Color(1, 1, 1, 1)
theme_override_fonts/normal_font = ExtResource("2_7orem")
theme_override_fonts/bold_font = ExtResource("3_p8iyf")
theme_override_font_sizes/normal_font_size = 14
text = "- If there is no facilitator, sort the answer cards (cards with a key). Make a pile of each color and put the cards in the right order. Place the piles next to the game board next to the question cards (cards with a lock). If there is a facilitator, this step is not necessary, the list of answers (booklet of questions and answers) can then be used."
fit_content = true

[node name="RichTextLabel5" type="RichTextLabel" parent="Panel/Container/RightSide/PreperationText"]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2
theme_override_colors/default_color = Color(1, 1, 1, 1)
theme_override_fonts/normal_font = ExtResource("2_7orem")
theme_override_fonts/bold_font = ExtResource("3_p8iyf")
theme_override_font_sizes/normal_font_size = 14
text = "- A PowerPoint has been created, where you can indicate at the beginning which question should be shown on the screen."
fit_content = true

[node name="RichTextLabel6" type="RichTextLabel" parent="Panel/Container/RightSide/PreperationText"]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2
theme_override_colors/default_color = Color(1, 1, 1, 1)
theme_override_fonts/normal_font = ExtResource("2_7orem")
theme_override_fonts/bold_font = ExtResource("3_p8iyf")
theme_override_font_sizes/normal_font_size = 14
text = "-  Also included with this game is a booklet. In this booklet there are 4 questions printed on one page. The participants can use this booklet when a question is asked."
fit_content = true

[node name="RichTextLabel7" type="RichTextLabel" parent="Panel/Container/RightSide/PreperationText"]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2
theme_override_colors/default_color = Color(1, 1, 1, 1)
theme_override_fonts/normal_font = ExtResource("2_7orem")
theme_override_fonts/bold_font = ExtResource("3_p8iyf")
theme_override_font_sizes/normal_font_size = 14
text = "- Preferably, form teams of 2, however the game can also be played by individual player or teams of 3. each team chooses 2 pawns of the same color, but do not place them on the game board yet"
fit_content = true

