layout_mode = 2
theme_override_colors/default_color = Color(1, 1, 1, 1)
theme_override_fonts/normal_font = ExtResource("2_7orem")
theme_override_fonts/bold_font = ExtResource("3_p8iyf")
theme_override_font_sizes/normal_font_size = 14
text = "Devops is a combination of development and operations that provides ongoing value through the combination of people
processes, and technology"
fit_content = true

[node name="RichTextLabel2" type="RichTextLabel" parent="Panel/Container/LeftSide/IntroductionText"]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2
theme_override_colors/default_color = Color(1, 1, 1, 1)
theme_override_fonts/normal_font = ExtResource("2_7orem")
theme_override_fonts/bold_font = ExtResource("3_p8iyf")
theme_override_font_sizes/normal_font_size = 14
text = "Teams that move to DevOps build better products faster and deliver higher customer satisfaction than traditional teams"
fit_content = true

[node name="RichTextLabel3" type="RichTextLabel" parent="Panel/Container/LeftSide/IntroductionText"]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2
theme_override_colors/default_color = Color(1, 1, 1, 1)
theme_override_fonts/normal_font = ExtResource("2_7orem")
theme_override_fonts/bold_font = ExtResource("3_p8iyf")
theme_override_font_sizes/normal_font_size = 14
theme_override_font_sizes/bold_font_size = 14
bbcode_enabled = true
text = "[b]This game is designed[/b] to playfully teach trade-offs and learn DevOps from all perspectives."
fit_content = true

[node name="RichTextLabel4" type="RichTextLabel" parent="Panel/Container/LeftSide/IntroductionText"]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2
theme_override_colors/default_color = Color(1, 1, 1, 1)
theme_override_fonts/normal_font = ExtResource("2_7orem")
theme_override_fonts/bold_font = ExtResource("3_p8iyf")
theme_override_font_sizes/normal_font_size = 14
