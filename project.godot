; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DevOps Game v0.9.0"
run/main_scene="res://scenes/multiplayer.tscn"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://misc/icon.svg"

[autoload]

GameManager="*res://scripts/GameManager.gd"
ImportData="*res://scripts/ImportData.gd"
GlobalColors="*res://scripts/Global/GlobalColors.gd"
SaveSystem="*res://scripts/Global/SaveSystem.gd"
GlobalSettings="*res://scripts/Global/GlobalSettings.gd"

[dotnet]

project/assembly_name="Dev Ops Game V 1.1"

[editor_plugins]

enabled=PackedStringArray("res://addons/fontawesome/plugin.cfg")

[input]

mouse_left_click={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":1,"position":Vector2(545, 23),"global_position":Vector2(554, 71),"factor":1.0,"button_index":1,"canceled":false,"pressed":true,"double_click":false,"script":null)
]
}

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
textures/lossless_compression/force_png=true
anti_aliasing/quality/msaa_3d=1
